# Base URL of the portfolio API (https://github.com/Gaboxqc/GaboxAPI).
# Point this at the deployed API if you do not want to run the backend locally —
# all read endpoints are public.
#
# Use `localhost`, not `127.0.0.1`. The admin dashboard authenticates with a
# SameSite=Lax session cookie, and the browser treats `localhost:5173` and
# `127.0.0.1:8000` as different sites — so the cookie is never sent and you get
# a login that appears to succeed but is signed out again on the next reload.
# In production this is a non-issue: gabrielmayorga.dev and
# api.gabrielmayorga.dev share a registrable domain and are same-site.
VITE_API_URL=http://localhost:8000/portfolio
